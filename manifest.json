{
  "manifest_version": 3,
  "name": "PR Resolver Info",
  "version": "1.0",
  "description": "Show the username of the thread resolver",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/pull/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}